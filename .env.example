# Optional model choices for compose.openai.yaml. The default run is mock-only.
# Keep API keys out of this file; the live override uses a Compose secret.
MAS_PLANNER_MODEL=gpt-4.1-mini
MAS_REVIEWER_MODEL=gpt-4o-mini

# Admission allowance per paid call, in microUSD; not an actual billing estimate.
MAS_CALL_RESERVATION_MICROUSD=100000
